{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "examples", "test.ts"],
  // The Firestore adapters have `firebase` / `firebase-admin` peer dependencies;
  // typecheck them after installing those. Excluded here so the default
  // `npm run typecheck` stays green without pulling in either.
  "exclude": ["src/adapters/firestore.ts", "src/adapters/firestore-admin.ts"]
}
